{# Fichier: templates/books/detail.html.twig #}
{% extends 'twig_heritage/template.html.twig' %}

{% block title %}
    {{ book.title }} - Détails
{% endblock %}

{% block body %}
    {# Fil d'ariane #}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb margin-top:1em; margin-bottom:1em; margin-left:1em">
            <li class="breadcrumb-item"><a href="{{ path('books.filtered') }}">Tout les livres</a></li>           
            <li class="breadcrumb-item active" aria-current="page">{{ book.title }}</li>
        </ol>
    </nav>
    
    <div class="card" style="width: 100%;">
        <div class="card-body">
            <img src="{{ asset('uploads/covers/' ~ book.cover) }}" style="width:15rem;" alt="Couverture du livre {{ book.title }}" onerror="this.src='{{ asset('images/no-image.svg') }}'">
            <div style="margin-top:1em; margin-bottom:1em;">
                {% for imageUrl in book.imageUrls %}
                    <img src="{{ asset(imageUrl) }}" style="width:200px; margin-left: 1rem; margin-right: 1rem;" alt="Image du livre {{ book.title }}" onerror="this.src='{{ asset('images/no-image.svg') }}'">
                {% endfor %}
            </div>
            <p class="card-text"><span style="font-weight: bold;">titre:</span> {{ book.title }}</p>
            <p class="card-text"><span style="font-weight: bold;">auteur:</span> {{ book.authorName }}</p>
            <p class="card-text"><span style="font-weight: bold;">prix:</span> {{ book.price|centimes_to_euros }} EUR</p>
            <p class="card-text"><span style="font-weight: bold;">format:</span> {{ book.format.value }}</p>
            <p class="card-text"><span style="font-weight: bold;">nb de pages:</span> {{ book.pageCount }}</p>
            <p class="card-text"><span style="font-weight: bold;">date de création:</span> {{ book.createdAt | european_date }}</p>
            <p class="card-text"><span style="font-weight: bold;">description:</span> {{ book.description }}</p>
            <p class="card-text"><span style="font-weight: bold;">extrait:</span> {{ book.extract }}</p>
            <p class="card-text"><span style="font-weight: bold;">categories:</span>
                {% for category in book.categories %}
                    {{ category.name }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            </p>
            
            
                
            
            
        </div>
    </div>
     <div style="margin-top:1em; margin-bottom: 1em;">
            <a href="{{ path('books.filtered') }}" class="card-link" id="retour" >Retour vers Tout les livres</a>
        </div>
    
{% endblock %}