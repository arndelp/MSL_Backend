<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style type="text/css">
        /* Styles généraux */
        body {
            margin: 0 !important;
            padding: 20px !important;
            background-color: #f7f7f7;
        }

        /* Responsive mobile */
        @media only screen and (max-width: 600px) {
            .container {
                width: 100% !important;
                max-width: 100% !important;
            }

            .content {
                padding: 20px !important;
            }

            .button-cell {
                display: block !important;
                width: 100% !important;
                padding: 0 0 20px 0 !important;
                text-align: center !important;
            }

            .button-cell:last-child {
                padding-bottom: 0 !important;
            }

            .button-table {
                margin: 0 auto !important;
            }

            .button {
                display: block !important;
            }
        }
    </style>
</head>

<body style="margin:0; padding:20px; font-family:Arial, Helvetica, sans-serif; background-color:#f7f7f7;">

    <!-- Conteneur principal -->
    <table
        role="presentation"
        width="100%"
        border="0"
        cellspacing="0"
        cellpadding="0"
        style="width:100%; max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:8px;"
        class="container"
    >
        <tr>
            <td class="content" style="padding:30px;">

                <!-- Logo -->
                <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td align="center" style="padding-bottom:20px;">
                            <img
                                src="{{ logoUrl }}"
                                alt="Mon Salon du Livre"
                                width="160"
                                border="0"
                                style="display:block; width:160px; max-width:100%; height:auto;"
                            >
                        </td>
                    </tr>
                </table>

                <!-- Contenu -->
                <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td>

                            <h1 style="color:#2c3e50; font-size:24px; line-height:1.3; margin:0 0 20px 0; text-align:center;">
                                Nouvelle commande à confirmer
                            </h1>

                            <p style="font-size:16px; line-height:1.5; color:#333333; margin:0 0 25px 0;">
                                Bonjour cher vendeur,
                            </p>

                            {% for orderItem in sellerPayment.orderItems %}

                                <p style="font-size:16px; line-height:1.5; color:#333333; margin:0 0 8px 0;">
                                    Vous avez vendu :
                                    <strong>{{ orderItem.bookTitle }}</strong>
                                </p>

                                <p style="font-size:16px; line-height:1.5; color:#333333; margin:0 0 8px 0;">
                                    Format :
                                    <strong>{{ orderItem.book.format.value }}</strong>
                                </p>

                                <p style="font-size:16px; line-height:1.5; color:#333333; margin:0 0 20px 0;">
                                    Quantité :
                                    <strong>{{ orderItem.quantity }}</strong>
                                </p>

                            {% endfor %}

                            <p style="font-size:16px; line-height:1.5; color:#333333; margin:0 0 20px 0;">
                                    Numéro de commande :
                                    <strong>{{ sellerPayment.paymentNumber }}</strong>
                                </p>

                            <p style="font-size:16px; line-height:1.5; color:#333333; margin:25px 0 8px 0;">
                                <strong>Méthode d'expédition :</strong>
                            </p>

                            <p style="font-size:15px; line-height:1.5; color:#555555; margin:0 0 20px 0;">
                                {{ sellerPayment.carrierName }}
                            </p>

                            <p style="font-size:15px; line-height:1.5; color:#555555; margin:0;">
                                L'adresse complète d'expédition est disponible sur votre compte client.
                            </p>

                        </td>
                    </tr>
                </table>

                <!-- Espacement -->
                <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td height="30" style="height:30px; line-height:30px; font-size:1px;">
                            &nbsp;
                        </td>
                    </tr>
                </table>

                <!-- Boutons -->
                <table
                    role="presentation"
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    width="100%"
                >
                    <tr>

                        <!-- Confirmer -->
                        <td
                            class="button-cell"
                            align="center"
                            valign="middle"
                            style="text-align:center; padding:0 35px 0 0;"
                        >
                            <table
                                role="presentation"
                                border="0"
                                cellspacing="0"
                                cellpadding="0"
                                class="button-table"
                                style="margin:0 auto;"
                            >
                                <tr>
                                    <td
                                        align="center"
                                        bgcolor="#03C755"
                                        style="border-radius:6px;"
                                    >
                                        <a
                                            href="{{ acceptUrl }}"
                                            class="button"
                                            style="
                                                display:inline-block;
                                                padding:12px 24px;
                                                font-family:Arial, Helvetica, sans-serif;
                                                font-size:16px;
                                                line-height:20px;
                                                color:#ffffff;
                                                text-decoration:none;
                                                background-color:#03C755;
                                                border-radius:6px;
                                            "
                                        >
                                            Confirmer la vente
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>

                        <!-- Refuser -->
                        <td
                            class="button-cell"
                            align="center"
                            valign="middle"
                            style="text-align:center;"
                        >
                            <table
                                role="presentation"
                                border="0"
                                cellspacing="0"
                                cellpadding="0"
                                class="button-table"
                                style="margin:0 auto;"
                            >
                                <tr>
                                    <td align="center">
                                        <a
                                            href="{{ refuseUrl }}"
                                            style="
                                                display:inline-block;
                                                padding:12px 10px;
                                                font-family:Arial, Helvetica, sans-serif;
                                                font-size:16px;
                                                line-height:20px;
                                                color:#d9534f;
                                                text-decoration:none;
                                            "
                                        >
                                            Refuser
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>

                    </tr>
                </table>

            </td>
        </tr>
    </table>

</body>
</html>